FROM nvidia/cuda:12.2.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common curl ca-certificates git \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-distutils python3-pip \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy minimal requirements for serving/training examples
COPY requirements-gpu.txt /tmp/requirements-gpu.txt
RUN python3.11 -m pip install --upgrade pip \
    && python3.11 -m pip install -r /tmp/requirements-gpu.txt

# Copy code
COPY app app
COPY ml ml
COPY serving/bento serving/bento
COPY pyproject.toml README.md ./

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTHONUNBUFFERED=1

# Default command runs a simple inference server via Bento during runtime override
CMD ["python3.11", "-m", "http.server", "8080"]

